# Copy to .env.local for local development.
# On Vercel, set these in Project → Settings → Environment Variables
# (do NOT commit .env / .env.local).

# ── Database (required) ───────────────────────────────────────────────
# Neon / Postgres connection string. The Vercel + Neon integration sets
# DATABASE_URL (and POSTGRES_URL) automatically when you add the Neon store.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Auth secrets (required) ───────────────────────────────────────────
# Long random string used to sign login cookies (>= 16 chars).
SESSION_SECRET=replace-with-a-long-random-secret

# Required to create the first Super Admin (platform owner), >= 8 chars.
SETUP_SECRET=digicon-valley

# ── File uploads (optional) ───────────────────────────────────────────
# Set automatically when you connect a Vercel Blob store to the project.
# Without it, task file attachments are disabled (the rest of the app works).
BLOB_READ_WRITE_TOKEN=

# ── Password reset emails (optional) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=ClarityTrack <onboarding@resend.dev>

# ── Cookies (optional) ────────────────────────────────────────────────
# Force Secure cookies (1) or allow HTTP cookies (0). On Vercel leave unset
# (HTTPS is auto-detected).
# COOKIE_SECURE=1
